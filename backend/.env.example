# Copy this file to .env and replace every placeholder before running the API.
SARVAM_API_KEY=replace-with-your-sarvam-key

# Local edge-device account sessions
CHAABI_ACCOUNT_SESSION_IDLE_TTL_SECONDS=900
CHAABI_ACCOUNT_SESSION_ABSOLUTE_TTL_SECONDS=28800
# Set true only when the app is served over HTTPS.
CHAABI_SESSION_COOKIE_SECURE=false

# Speech and challenge settings
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANGUAGE_CODE=en-IN
SARVAM_STT_MODE=transcribe
CHAABI_CHALLENGE_TTL_SECONDS=120
CHAABI_USE_LLM_INTENT=false

# Upload and authentication abuse controls
CHAABI_MAX_AUDIO_BYTES=8388608
CHAABI_MIN_AUDIO_DURATION_MS=1000
CHAABI_MAX_AUDIO_DURATION_MS=8000
CHAABI_AUTH_FAILURE_LIMIT=5
CHAABI_AUTH_FAILURE_WINDOW_SECONDS=300

# Prototype DSP and speaker thresholds; calibrate before changing these.
CHAABI_INCONCLUSIVE_LIVENESS_SCORE=0.70
CHAABI_SPEAKER_SIMILARITY_THRESHOLD=0.74
CHAABI_MIN_ENROLLMENT_SPEAKER_SIMILARITY=0.75
CHAABI_SPEAKER_SIMILARITY_MAX_THRESHOLD=0.90
CHAABI_SPEAKER_SIMILARITY_MARGIN=0.06

# This is encrypted inside the voice-recoverable vault.
CHAABI_PROTECTED_PAYLOAD=CHAABI_ACCESS_GRANTED
